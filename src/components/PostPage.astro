---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import { getCategoryUrl } from "../utils/url-utils";

const { page } = Astro.props;

const entries = await Promise.all(page.data.map(async (entry: CollectionEntry<"posts">) => ({ entry, rendered: await entry.render() })));
---
<div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
    {entries.map(({entry, rendered}) => (
        <article class="post-list-item">
            <h2><a href={getPostUrlBySlug(entry.slug)}>{entry.data.title}</a></h2>
            <div class="post-list-meta">
                <time datetime={entry.data.published.toISOString()}>{entry.data.published.toISOString().slice(0, 10)}</time>
                <a href={getCategoryUrl(entry.data.category)}>{entry.data.category}</a>
                {entry.data.draft && <span>草稿</span>}
            </div>
            <p class="line-clamp-2">{entry.data.description || rendered.remarkPluginFrontmatter.excerpt}</p>
        </article>
    ))}
</div>
