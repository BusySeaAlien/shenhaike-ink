---
import { profileConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	class: string;
}

const { pubDate } = Astro.props;
const className = Astro.props.class;
const profileConf = profileConfig;
const inkImages = [
	"/images/license-card/ink-mountains.png",
	"/images/license-card/ink-lake.png",
];
const inkImage = inkImages[Math.floor(Math.random() * inkImages.length)];
---
<div class={`relative transition overflow-hidden bg-[var(--license-block-bg)] py-5 px-6 md:pr-56 ${className}`}>
    <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-56 md:block" aria-hidden="true">
        <img src={inkImage} alt="" class="h-full w-full object-cover opacity-60 [mask-image:linear-gradient(to_left,black_0%,black_70%,transparent_100%)]" />
    </div>
    <div class="relative flex flex-col gap-2 text-black/75 dark:text-white/75">
        <div>
            <span class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.author)}</span>
            <span class="ml-3">{profileConf.name}</span>
        </div>
        <div class="flex gap-6">
            <span><span class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.publishedAt)}</span><span class="ml-3">{formatDateToYYYYMMDD(pubDate)}</span></span>
            <span>保留所有权利</span>
        </div>
    </div>
</div>
