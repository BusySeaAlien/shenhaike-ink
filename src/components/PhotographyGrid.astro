---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import ImageWrapper from "./misc/ImageWrapper.astro";
import { getDir, getPostUrlBySlug } from "../utils/url-utils";
interface Props { posts: CollectionEntry<"posts">[] }
const { posts } = Astro.props;
---
{posts.length === 0 ? <p class="empty-state">摄影作品将在这里陆续发布。</p> :
<div class="photography-grid">
    {posts.map(post => <a class="photography-item" href={getPostUrlBySlug(post.slug)}>
        {post.data.image ? <ImageWrapper src={post.data.image} basePath={path.join("content/posts/", getDir(post.id))} alt={post.data.title} class="photography-cover" /> : <div class="photography-cover missing-cover">{post.data.title}</div>}
        <h3>{post.data.title}</h3>
        <time datetime={post.data.published.toISOString()}>{post.data.published.toISOString().slice(0, 10)}</time>
        {post.data.description && <p>{post.data.description}</p>}
    </a>)}
</div>}
