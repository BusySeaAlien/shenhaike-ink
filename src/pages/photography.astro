---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PhotographyGrid from "../components/PhotographyGrid.astro";
import { getSortedPosts } from "../utils/content-utils";
const posts = (await getSortedPosts()).filter(post => post.data.category === "摄影");
---
<MainGridLayout title="摄影" description="深海客的摄影作品">
    <header class="collection-heading"><h1>摄影</h1></header>
    <PhotographyGrid posts={posts} />
</MainGridLayout>
